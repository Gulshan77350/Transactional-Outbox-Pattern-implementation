# Connection string for processes running on the host. The replica-set member
# is registered as "mongo:27017", which the host cannot resolve, so host-side
# clients connect directly to the primary instead of doing topology discovery.
MONGO_URI=mongodb://localhost:27017/outbox?directConnection=true

LOG_LEVEL=info

# Order API
PORT=3000

# Shared secret consumers present to the relay (Socket.IO handshake auth).
# Unset disables the check; the relay logs a warning when it is missing.
RELAY_AUTH_TOKEN=local-dev-token

# Relay
SOCKET_PORT=4000
# Unique per relay instance; defaults to relay-<hostname>-<pid>
# WORKER_ID=relay-1
POLL_INTERVAL_MS=50
BATCH_SIZE=100
# Batches that may be awaiting consumer acks while the next one is claimed
MAX_IN_FLIGHT_BATCHES=2
# Must be larger than ACK_TIMEOUT_MS (checked at startup)
LEASE_MS=10000
ACK_TIMEOUT_MS=5000
MAX_ATTEMPTS=8
BACKOFF_BASE_MS=200
BACKOFF_MAX_MS=30000

# Consumer
# Comma-separated list of relay instances to subscribe to
RELAY_URLS=http://localhost:4000
# Events processed concurrently (bounded to avoid transaction write conflicts)
CONSUMER_CONCURRENCY=8

# Fault injection - demos and benchmarks only, keep at 0 otherwise
# Exit the relay right after the Nth successful emit (before mark-as-sent)
FAULT_CRASH_AFTER_EMITS=0
# Probability that a claimed event is abandoned before its emit
FAULT_DROP_RATE=0
