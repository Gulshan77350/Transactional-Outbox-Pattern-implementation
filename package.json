{
  "name": "outbox-relay",
  "version": "1.0.0",
  "description": "Transactional Outbox pattern on MongoDB transactions with a Socket.IO relay and idempotent consumers",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:api": "node src/entrypoints/api.js",
    "start:relay": "node src/entrypoints/relay.js",
    "start:consumer": "node src/entrypoints/consumer.js",
    "start:naive": "node src/baseline/naive-api.js",
    "demo:crash": "node scripts/demo-crash-recovery.js",
    "demo:duplicate": "node scripts/demo-duplicate-delivery.js",
    "outbox:requeue-failed": "node scripts/requeue-failed.js",
    "bench": "node bench/run-all.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "keywords": [
    "outbox",
    "transactional-outbox",
    "mongodb",
    "socket.io",
    "event-driven"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-istanbul": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "undici": "^8.12.3",
    "vitest": "^5.0.5"
  }
}
